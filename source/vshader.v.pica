; Smiler 3DS vertex shader: transforms vertices, passes UVs, simple directional light.

; Uniforms
.fvec projection[4], modelView[4]
.fvec lightK                ; x = how much of the lighting to use (1 = lit scenery, 0 = flat)
.fvec tint                  ; colour added after lighting: scenery (0,0,0,1), sky (1,1,1,1), menus = the sprite colour
.fvec uvxf                 ; texture-coordinate transform: scale.xy, offset.zw (for animated screens)

; Constants
.constf myconst(0.0, 1.0, 0.45, 0.55)
.constf lightdir(0.35, 0.80, -0.45, 0.0)
.alias zeros myconst.xxxx
.alias ones  myconst.yyyy

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outclr color

; Inputs
.alias inpos v0
.alias intex v1
.alias innrm v2

.proc main
	; position
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; texture coordinates (scaled and offset so screens and chains can animate)
	mul r5, uvxf, intex
	add outtc0, uvxf.zwzw, r5

	; lighting: rotate the normal into view space, then ambient + diffuse
	mov r2.xyz, innrm
	mov r2.w,   zeros
	dp4 r3.x, modelView[0], r2
	dp4 r3.y, modelView[1], r2
	dp4 r3.z, modelView[2], r2
	dp3 r4, lightdir, r3
	max r4, zeros, r4
	mul r4, myconst.wwww, r4
	add r4, myconst.zzzz, r4
	mul r4, lightK.xxxx, r4
	mov r4.w, zeros
	add r4, tint, r4
	mov outclr, r4

	end
.end
